# Modelo da configuração da API. Copie para backend/.env e preencha:
#   cp backend/.env.example backend/.env
# O backend/.env é SEU e SENSÍVEL: está no .gitignore, nunca vai para o git.
# No Cloudflare, ele vira secrets do Worker com: ./deploy.sh secrets
# Onde fica cada arquivo de configuração: backend/README.md#where-things-live

# ─── 1. SEGREDOS (obrigatórios, nunca compartilhe) ──────────────────────────────
# Token da integração do Notion (só "Ler conteúdo"): notion.so/profile/integrations
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxx
# ID da base de tasks: os 32 caracteres antes do "?" na URL da base
NOTION_DATABASE_ID=00000000000000000000000000000000
# Senha do dashboard (≥ 16 caracteres). Gere com: openssl rand -base64 24
# Se tiver # ou espaços, use aspas: KAHUY_PASSWORD="..." (sem aspas, o # vira comentário)
KAHUY_PASSWORD=troque-por-uma-senha-de-16-ou-mais

# ─── 2. SUA BASE DO NOTION (opcional: só se os nomes forem diferentes destes) ────
NOTION_FIELD_TITLE=Task
NOTION_FIELD_HOURS=Horas
NOTION_FIELD_STATUS=Status
NOTION_FIELD_DATE=Data
NOTION_FIELD_TYPE=Tipo
# Status que contam como concluído (separados por vírgula)
DONE_STATUSES=Concluido
# Tipos de task de teste: nelas o [Nome] do título é o dev (card "Horas de teste por dev")
TEST_TYPES=TESTE

# ─── 3. META (opcional) ─────────────────────────────────────────────────────────
HOURS_PER_DAY=8
GOAL_TIERS=100,125
# Força os dias úteis de um mês (vence o cálculo por feriados)
# WORKING_DAYS={"2026-11":19}

# ─── 4. FÉRIAS E FOLGAS (pessoal) ───────────────────────────────────────────────
# Prefira o arquivo backend/holidays.local.json (fora do git; modelo: holidays.local.example.json).
# HOLIDAYS aqui, se existir, VENCE o arquivo. Formatos: 2026-11-02,2026-11-20 ou '{"2026-11-02":"Folga"}'
# HOLIDAYS=
# Feriados nacionais NÃO vão aqui: ficam em backend/holidays.json (versionado; npm run holidays -- 2028)

# ─── 5. AMBIENTE (opcional) ─────────────────────────────────────────────────────
TIMEZONE=America/Sao_Paulo
# Porta local da API (sempre em 127.0.0.1); não vai para o Cloudflare
PORT=8787
# Node atrás de um proxy reverso seu: limita o login pelo X-Forwarded-For
# TRUST_PROXY=true
# Só se o front ficar em outro subdomínio
# ALLOWED_ORIGIN=https://kahuy.exemplo.com
