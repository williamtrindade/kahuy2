{
  "name": "kahuy-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/FrameworksAndDrivers/Entrypoints/node.ts",
    "start": "tsx src/FrameworksAndDrivers/Entrypoints/node.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "holidays": "node scripts/fetch-holidays.mjs",
    "cf:secrets": "tsx scripts/env-to-json.ts .env > .wrangler-secrets.json && wrangler secret bulk .wrangler-secrets.json; rm -f .wrangler-secrets.json",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "hono": "^4.13.16"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261106.1",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  },
  "engines": {
    "node": ">=20.12"
  }
}
